  "keywords": [
    "203c",
    "203cli",
    "203-systems",
    "cardenza",
    "deprecated"
  ],
  "author": "203 Systems",
  "license": "MIT",
  "type": "module",
  "homepage": "https://www.npmjs.com/package/203cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/203-Systems/203-CLI.git",
    "directory": "legacy/203c"
  },
  "bugs": {
    "url": "https://github.com/203-Systems/203-CLI/issues"
  },
  "bin": {
    "203c": "203c.mjs"
  },
  "files": [
    "203c.mjs",
    "lib.mjs",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "203cli": "^3.5.1"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
