{
  "name": "203cli",
  "version": "3.5.1",
  "description": "203cli (formerly 203c), the 203 Systems firmware community's CLI (Cardenza 鸣片, NullPerator, Mystrix): start a firmware project, install it on a device over USB, read its log, publish it; with the Agent Skill and every device's development guide",
  "keywords": [
    "203cli",
    "203c",
    "203-systems",
    "cardenza",
    "firmware",
    "esp32-s3",
    "esp-idf",
    "cli",
    "agent-skill",
    "claude-code"
  ],
  "author": "203 Systems",
  "license": "MIT",
  "type": "module",
  "homepage": "https://cardenza.203.io/community/develop",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/203-Systems/203-CLI.git"
  },
  "bugs": {
    "url": "https://github.com/203-Systems/203-CLI/issues"
  },
  "bin": {
    "203cli": "scripts/203cli.mjs"
  },
  "files": [
    "SKILL.md",
    "LICENSE",
    "scripts/",
    "reference/",
    "products/"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "reference": "node scripts/203cli.mjs help --reference > reference/cli.md",
    "rules": "node tools/sync-rules.mjs",
    "pack:check": "npm pack --dry-run"
  }
}
